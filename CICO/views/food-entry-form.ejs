<div class="mb-3"><label class="form-label" for="dateTime">Date and Time</label><input class="form-control" type="datetime-local" id="dateTime" name="dateTime" value="<%= foodEntry?.dateTime?.replace(' ','T').slice(0,16) || '' %>" required></div><div class="mb-3"><label class="form-label" for="foodName">Food Name</label><input class="form-control" type="text" id="foodName" name="foodName" maxlength="255" value="<%= foodEntry?.foodName || '' %>" required></div><div class="row"><div class="col-md-4 mb-3"><label class="form-label" for="calories">Calories</label><input class="form-control" type="number" min="0" step="1" id="calories" name="calories" value="<%= foodEntry?.calories ?? '' %>" required></div><div class="col-md-4 mb-3"><label class="form-label" for="servingSize">Serving Size</label><input class="form-control" type="number" min="1" step="1" id="servingSize" name="servingSize" value="<%= foodEntry?.servingSize ?? 1 %>" required></div><div class="col-md-4 mb-3"><label class="form-label" for="unit">Unit</label><select class="form-select" id="unit" name="unit"><% for(const unit of ['serving','gram','ounce','pound']){ %><option value="<%= unit %>" <%= (foodEntry?.unit || 'serving')===unit?'selected':'' %>><%= unit %></option><% } %></select></div></div><fieldset class="mb-3"><legend class="fs-6">Meal</legend><% for(const m of meals){ %><div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="meal" id="meal-<%= m.id %>" value="<%= m.id %>" <%= Number(foodEntry?.meal_id??1)===m.id?'checked':'' %> required><label class="form-check-label" for="meal-<%= m.id %>"><%= m.name %></label></div><% } %></fieldset><fieldset class="mb-3"><legend class="fs-6">Tags</legend><% for(const t of tags){ %><div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="tags[]" id="tag-<%= t.id %>" value="<%= t.id %>" <%= relatedTags.includes(t.id)?'checked':'' %>><label class="form-check-label" for="tag-<%= t.id %>"><%= t.name %></label></div><% } %></fieldset>
