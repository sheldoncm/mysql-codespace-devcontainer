<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4"><div><h1 class="mb-1">Food Entries</h1><p class="text-secondary mb-0">Your calorie-in food diary</p></div><a class="btn btn-primary" href="/food-entry/create">Add Food Entry</a></div><form method="GET" action="/" class="row g-2 mb-4"><div class="col-sm"><label for="search" class="form-label">Search by food name</label><input class="form-control" type="search" id="search" name="search" value="<%= searchTerm %>" placeholder="For example, rice"></div><div class="col-sm-auto d-flex align-items-end gap-2"><button class="btn btn-primary" type="submit">Search</button><a class="btn btn-outline-secondary" href="/">Clear</a></div></form><% if(!foodEntries.length){ %><div class="alert alert-info" role="status"><% if(searchTerm){ %>No food entries found for "<%= searchTerm %>".<% } else { %>There are no food entries yet. Use Add Food Entry to create one.<% } %></div><% } %><div class="card shadow-sm"><div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead class="table-light"><tr><th>Date</th><th>Food Name</th><th>Calories</th><th>Meal</th><th>Serving Size</th><th>Unit</th><th>Tags</th><th>Actions</th></tr></thead><tbody><% for(const f of foodEntries){ %><tr><td><%= f.dateTime %></td><td class="fw-semibold"><%= f.foodName %></td><td><%= f.calories %></td><td><%= f.meal || 'N/A' %></td><td><%= f.servingSize %></td><td><%= f.unit %></td><td><%= f.selected_tags || '—' %></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-secondary" href="/food-entry/<%= f.id %>/edit">Edit</a> <a class="btn btn-sm btn-outline-danger" href="/food-entry/<%= f.id %>/delete">Delete</a></td></tr><% } %></tbody></table></div></div>
